{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdi-gabriel-jesus",
  // Entrada customizada (guia TanStack Start + Cloudflare): reexporta o handler do TanStack
  // e trata erros SSR. Ver src/server.ts.
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdi-gabriel-jesus",
      // TODO: substituir pelo ID real na Fase 6 (wrangler d1 create, com autorização do Gabriel).
      "database_id": "TODO",
      "migrations_dir": "migrations",
    },
  ],
}
