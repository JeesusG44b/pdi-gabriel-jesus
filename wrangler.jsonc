{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdi-gabriel-jesus",
  // Entrada customizada (guia TanStack Start + Cloudflare): reexporta o handler do TanStack
  // e trata erros SSR. Ver src/server.ts.
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdi-gabriel-jesus",
      // ID do D1 de produção (wrangler d1 create pdi-gabriel-jesus).
      "database_id": "41220ceb-1ab5-450b-a985-c1aa679ff581",
      "migrations_dir": "migrations",
    },
  ],
}
